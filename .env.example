# Copy this file to .env and replace the values with your own

# ───────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION (OIDC)
# ───────────────────────────────────────────────────────────────────────────────
# Supports any OpenID Connect provider (recommended: Logto — https://logto.io/)
#
# Logto Setup:
#   1. Create a "Traditional Web" application in Logto Console
#   2. Set the redirect URI to: munify-chase://oidc-callback
#   3. Copy the App ID → PUBLIC_OIDC_CLIENT_ID

# [REQUIRED] OIDC Discovery URL
# Logto: https://<your-tenant>.logto.app/oidc/.well-known/openid-configuration
PUBLIC_OIDC_AUTHORITY=https://<your-tenant>.logto.app/oidc/.well-known/openid-configuration

# [REQUIRED] OAuth2 Client ID from your OIDC provider
PUBLIC_OIDC_CLIENT_ID=your-client-id

# [OPTIONAL] Override the GraphQL API URL.
# Defaults to https://chase.munify.cloud/api/graphql in Tauri, /api/graphql in web.
# PUBLIC_API_URL=https://chase.munify.cloud/api/graphql

# [OPTIONAL] Contact email displayed on the landing page for conference organizers
# PUBLIC_CONTACT_EMAIL=chase@dmun.de
