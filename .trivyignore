CVE-2026-23745
CVE-2026-23950
CVE-2026-24842
CVE-2026-26960
CVE-2026-29786

# node-tar: DoS via gzip bomb / malformed archive header — same rationale as above.
# Confirmed this `tar` isn't from our own bun.lock at all (absent from it entirely) —
# it's bundled inside node:lts-slim's own npm install (/usr/local/lib/node_modules/npm/
# node_modules/tar), which the release image never invokes (CMD only runs drizzle-kit
# migrate + node server.js, no npm).
CVE-2026-59873
CVE-2026-59874
CVE-2026-73566

# ip-address: inconsistent parsing leading to SSRF - same rationale as the node-tar
# entries above: bundled inside node:lts-slim's own npm install
# (npm/node_modules/ip-address), never invoked by the release image at runtime.
CVE-2026-69192

