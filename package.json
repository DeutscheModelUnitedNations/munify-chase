{
	"name": "munify-chase",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"bun run dev:server\" \"bun run dev:docker\" \"compile-seed-schema\"",
		"dev:docker": "docker compose -f ./dev.docker-compose.yml up",
		"dev:server": "while true; do svelte-kit sync && bun run vite dev; echo 'Server crashed, restarting...'; sleep 1; done",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:reset": "bun ./src/lib/server/db/reset.ts",
		"db:seed:dev": "bun ./src/lib/server/db/seedConference.ts dev.yaml",
		"compile-seed-schema": "json-schema-to-typescript ./src/api/db/seed-data/schema.json > ./src/api/db/seed-data/schema.d.ts",
		"machine-translate": "inlang machine translate --project project.inlang",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.36.0",
		"@fontsource/outfit": "^5.2.8",
		"@fontsource/roboto-mono": "^5.2.8",
		"@fontsource/vollkorn": "^5.2.10",
		"@inlang/paraglide-js": "^2.3.2",
		"@m1212e/rumble": "^0.11.6",
		"@m1212e/sveltekit-oidc": "^0.0.33",
		"@sveltejs/adapter-node": "^5.3.2",
		"@sveltejs/kit": "^2.43.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/vite": "^4.1.13",
		"@tiptap/core": "^3.4.6",
		"@tiptap/extension-link": "^3.4.6",
		"@tiptap/extension-underline": "^3.4.6",
		"@tiptap/pm": "^3.4.6",
		"@tiptap/starter-kit": "^3.4.6",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^24.5.2",
		"@types/pg": "^8.15.5",
		"bits-ui": "^2.11.0",
		"concurrently": "^9.2.1",
		"dayjs": "^1.11.18",
		"dexie": "^4.2.0",
		"drizzle-seed": "^0.3.1-f92627f",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"flag-icons": "^7.5.0",
		"fuse.js": "^7.1.0",
		"globals": "^16.4.0",
		"hotkeys-js": "^3.13.15",
		"js-yaml": "^4.1.0",
		"json-schema-to-typescript": "^15.0.4",
		"lefthook": "^1.13.2",
		"nanoid": "^5.1.6",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"semantic-release": "^24.2.9",
		"svelte": "^5.39.4",
		"svelte-check": "^4.3.2",
		"svelte-confetti": "^2.3.2",
		"svelte-french-toast": "2.0.0-alpha.0",
		"svelte-grid-extended": "^1.2.1",
		"svelte-tiptap": "^3.0.0",
		"tailwindcss": "^4.1.13",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.44.1",
		"vite": "^7.1.7",
		"vite-plugin-devtools-json": "^1.0.0",
		"world-countries": "^5.1.0",
		"zod": "^4.1.11"
	},
	"dependencies": {
		"drizzle-kit": "^1.0.0-beta.1-f92627f",
		"drizzle-orm": "^1.0.0-beta.1-f92627f",
		"postgres": "^3.4.7"
	}
}
