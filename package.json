{
	"name": "munify-chase",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"bun run dev:server\" \"bun run dev:docker\"",
		"dev:server": "while true; do svelte-kit sync && bun --bun run vite-dev; echo 'Server crashed, restarting...'; sleep 1; done",
		"dev:docker": "docker compose -f ./dev.docker-compose.yml up",
		"vite-dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.7",
		"@eslint/js": "^9.22.0",
		"@inlang/plugin-message-format": "^4.0.0",
		"@m1212e/rumble": "^0.2.1",
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/kit": "^2.20.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.0.14",
		"concurrently": "^9.1.2",
		"drizzle-kit": "^0.30.5",
		"drizzle-orm": "^0.40.1",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-svelte": "^3.3.0",
		"globals": "^16.0.0",
		"lefthook": "^1.11.3",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.23.1",
		"svelte-check": "^4.1.5",
		"tailwindcss": "^4.0.14",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.26.1",
		"vite": "^6.2.2"
	},
	"dependencies": {
		"@inlang/paraglide-sveltekit": "^0.16.1"
	}
}
