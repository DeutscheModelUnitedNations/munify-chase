	"name": "munify-chase",
	"private": true,
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"compile-seed-schema": "bunx json-schema-to-typescript ./src/api/db/seed-data/schema.json > ./src/api/db/seed-data/schema.d.ts",
		"db:migrate": "drizzle-kit migrate",
		"db:nuke": "docker compose -f ./dev.docker-compose.yml down -v && docker compose -f ./dev.docker-compose.yml up -d --wait && bun run db:migrate",
		"db:push": "drizzle-kit push",
		"db:reset": "bun ./src/api/db/reset.ts",
		"db:seed:dev": "bun ./src/api/db/seedConference.ts dev.yaml",
		"db:studio": "drizzle-kit studio",
		"dev": "concurrently --names server,docker,schema --prefix-colors blue,yellow,magenta \"bun run dev:server\" \"bun run dev:docker\" \"compile-seed-schema\"",
		"dev:docker": "docker compose -f ./dev.docker-compose.yml up",
		"link:client": "bun scripts/linkClient.ts",
		"dev:linked": "concurrently --names server,docker --prefix-colors blue,yellow \"bun run dev:linked:server\" \"docker compose -f ./dev.docker-compose.yml -f ./linked.docker-compose.yml up\"",
		"dev:linked:server": "svelte-kit sync && DATABASE_URL=postgres://postgres:postgres@localhost:15433/postgres OIDC_MOCK_PORT=8091 PUBLIC_OIDC_AUTHORITY=http://127.0.0.1:8090/oidc/.well-known/openid-configuration LINK_REMOTE_URL=http://localhost:5173 LINK_REMOTE_RESOURCE=http://localhost:5173/api LINK_RESOURCE=http://localhost:5174/api OIDC_M2M_CLIENT_ID=chase-m2m OIDC_M2M_CLIENT_SECRET=dev vite dev --port 5174 --strictPort",
		"db:migrate:linked": "DATABASE_URL=postgres://postgres:postgres@localhost:15433/postgres bun run db:migrate",
		"dev:server": "while true; do svelte-kit sync && bun run vite-dev; echo 'Server crashed, restarting...'; sleep 1; done",
		"fallow": "fallow --coverage coverage/coverage-final.json",
		"fallow:audit": "fallow audit --coverage coverage/coverage-final.json",
		"fallow:health": "fallow health --score --coverage coverage/coverage-final.json",
		"docs:screenshots": "bun scripts/docs-screenshots/run.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"i18n:check": "i18n-check --source \"de\" --locales ./messages --format \"i18next\"",
		"i18n:validate": "inlang validate --project project.inlang",
		"lint": "eslint .",
		"machine-translate": "inlang machine translate --project project.inlang",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit",
		"vite-dev": "vite dev"
	},
	"type": "module",
	"overrides": {
		"wonka": "6.3.6"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.10.0",
