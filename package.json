	"name": "munify-chase",
	"private": true,
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"compile-seed-schema": "bunx json-schema-to-typescript ./src/api/db/seed-data/schema.json > ./src/api/db/seed-data/schema.d.ts",
		"db:migrate": "drizzle-kit migrate",
		"db:nuke": "docker compose -f ./dev.docker-compose.yml down -v && docker compose -f ./dev.docker-compose.yml up -d --wait && bun run db:migrate",
		"db:push": "drizzle-kit push",
		"db:reset": "bun ./src/api/db/reset.ts",
		"db:seed:dev": "bun ./src/api/db/seedConference.ts dev.yaml",
		"db:studio": "drizzle-kit studio",
		"dev": "concurrently --names server,docker,schema --prefix-colors blue,yellow,magenta \"bun run dev:server\" \"bun run dev:docker\" \"compile-seed-schema\"",
		"dev:docker": "docker compose -f ./dev.docker-compose.yml up",
		"dev:server": "while true; do svelte-kit sync && bun run vite-dev; echo 'Server crashed, restarting...'; sleep 1; done",
		"fallow": "fallow",
		"fallow:audit": "fallow audit",
		"fallow:health": "fallow health --score",
		"docs:screenshots": "bun scripts/docs-screenshots/run.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"i18n:check": "i18n-check --source \"de\" --locales ./messages --format \"i18next\"",
		"i18n:validate": "inlang validate --project project.inlang",
		"lint": "eslint .",
		"machine-translate": "inlang machine translate --project project.inlang",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"vite-dev": "vite dev"
	},
	"type": "module",
	"overrides": {
		"wonka": "6.3.6"
	},
	"dependencies": {
		"@urql/core": "^6.0.3",
		"drizzle-kit": "^1.0.0-rc.5-ab785fc",
		"drizzle-orm": "^1.0.0-rc.5-ab785fc",
		"pg": "^8.23.1",
		"ws": "^8.22.0"
	},
	"version": "3.1.3",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": [
			"./src/lib/*",
			"./src/lib/*.ts",
			"./src/lib/*.js"
		],
		"#assets/*": "./src/assets/*",
		"#api/*": [
			"./src/api/*",
			"./src/api/*.ts",
			"./src/api/*.js"
		]
	},
	"patchedDependencies": {
		"@m1212e/sveltekit-oidc@0.0.46": "patches/@m1212e%2Fsveltekit-oidc@0.0.46.patch"
	}
