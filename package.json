{
  "name": "munify-chase",
  "private": true,
  "version": "2.0.8",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:docker\" \"compile-seed-schema\"",
    "dev:docker": "docker compose -f ./dev.docker-compose.yml up",
    "dev:server": "while true; do svelte-kit sync && bun run vite dev; echo 'Server crashed, restarting...'; sleep 1; done",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "db:start": "docker compose up",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:reset": "bun ./src/api/db/reset.ts",
    "db:seed:dev": "bun ./src/api/db/seedConference.ts dev.yaml",
    "compile-seed-schema": "json-schema-to-typescript ./src/api/db/seed-data/schema.json > ./src/api/db/seed-data/schema.d.ts",
    "machine-translate": "inlang machine translate --project project.inlang",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.2",
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/roboto-mono": "^5.2.8",
    "@fontsource/vollkorn": "^5.2.10",
    "@inlang/paraglide-js": "^2.7.1",
    "@m1212e/rumble": "^0.16.12",
    "@m1212e/sveltekit-oidc": "^0.0.33",
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/kit": "^2.49.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tiptap/core": "^3.10.2",
    "@tiptap/extension-history": "^3.10.2",
    "@tiptap/extension-image": "^3.10.2",
    "@tiptap/extension-link": "^3.10.2",
    "@tiptap/extension-placeholder": "^3.10.2",
    "@tiptap/extension-underline": "^3.10.2",
    "@tiptap/pm": "^3.10.2",
    "@tiptap/starter-kit": "^3.10.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "bits-ui": "^2.14.4",
    "concurrently": "^9.2.1",
    "daisyui": "^5.5.14",
    "dayjs": "^1.11.19",
    "dexie": "^4.2.1",
    "drizzle-seed": "^1.0.0-beta.8-734e789",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.1",
    "flag-icons": "^7.5.0",
    "fuse.js": "^7.1.0",
    "globals": "^16.5.0",
    "hotkeys-js": "^3.13.15",
    "js-yaml": "^4.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "lefthook": "^2.0.13",
    "nanoid": "^5.1.6",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.46.1",
    "svelte-check": "^4.3.5",
    "svelte-confetti": "^2.3.2",
    "svelte-fast-marquee": "^1.0.2",
    "svelte-french-toast": "2.0.0-alpha.0",
    "svelte-grid-extended": "^1.2.1",
    "svelte-tiptap": "^3.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.0",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.0.18",
    "world-countries": "^5.1.0",
    "zod": "^4.2.1"
  },
  "dependencies": {
    "drizzle-kit": "^1.0.0-beta.8-734e789",
    "drizzle-orm": "^1.0.0-beta.8-734e789",
    "pg": "^8.16.3"
  }
}
